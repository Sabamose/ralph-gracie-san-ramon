{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/our-team-1", "destination": "/team", "permanent": true },
    { "source": "/about-4", "destination": "/schedule", "permanent": true },
    { "source": "/dropin", "destination": "/drop-in", "permanent": true },
    { "source": "/copy-of-drop-in", "destination": "/contact", "permanent": true },
    { "source": "/events-1", "destination": "/events", "permanent": true },
    { "source": "/general-8", "destination": "/intro", "permanent": true },
    { "source": "/category/:path*", "destination": "/", "permanent": true },
    { "source": "/product-page/:path*", "destination": "/", "permanent": true },
    { "source": "/shop", "destination": "/", "permanent": true },
    { "source": "/cart-page", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
